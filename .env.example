# Public frontend configuration
NEXT_PUBLIC_GENLAYER_NETWORK=testnet-bradbury
NEXT_PUBLIC_GENLAYER_RPC=https://rpc-bradbury.genlayer.com
NEXT_PUBLIC_GENLAYER_EXPLORER=https://explorer-bradbury.genlayer.com
NEXT_PUBLIC_GENLAYER_CHAIN_ID=4221
NEXT_PUBLIC_VERDICTX_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DEMO_FALLBACK=false

# Testnet smoke/deployment configuration — NEVER expose the private key to NEXT_PUBLIC_* variables.
GENLAYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
SMOKE_PROVIDER_ADDRESS=0x0000000000000000000000000000000000000001
SMOKE_CASE_ID=VX-SMOKE-001
SMOKE_FUND_AMOUNT_GEN=1
SMOKE_EVIDENCE_URLS=https://example.com

# Optional explorer links used by documentation/build tooling
VERDICTX_EXPLORER_URL=https://explorer-bradbury.genlayer.com
ESCROW_EXPLORER_URL=https://explorer-bradbury.genlayer.com
