# Public frontend configuration
NEXT_PUBLIC_GENLAYER_NETWORK=studio-next
NEXT_PUBLIC_GENLAYER_RPC=https://studio-next.genlayer.com/api
NEXT_PUBLIC_GENLAYER_EXPLORER=https://explorer-studio-dev.genlayer.com
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_CHAIN_ID_HEX=0xf22d
NEXT_PUBLIC_VERDICTX_CONTRACT_ADDRESS=0x1885f214dbAba9f582F1982a2EC6DcAa2BF5D12f
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x23F5911406B0B66F395F0029d310031b09e266b6
NEXT_PUBLIC_DEMO_FALLBACK=false

# Testnet smoke/deployment configuration — NEVER expose the private key to NEXT_PUBLIC_* variables.
GENLAYER_PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
SMOKE_PROVIDER_ADDRESS=0x0000000000000000000000000000000000000001
SMOKE_CASE_ID=VX-SMOKE-001
SMOKE_FUND_AMOUNT_GEN=1
SMOKE_EVIDENCE_URLS=https://example.com

# Optional explorer links used by documentation/build tooling
VERDICTX_EXPLORER_URL=https://explorer-studio-dev.genlayer.com
ESCROW_EXPLORER_URL=https://explorer-studio-dev.genlayer.com
